                <tr> <td>State/Province</td><td><%= rfq_information.pickup_state %></td> </tr>
                <tr> <td>Country</td><td><%= rfq_information.pickup_country %></td> </tr>
                <tr> <td>ZIP/Postal</td><td><%= rfq_information.pickup_postal %></td> </tr>
                <tr> <td>Date</td><td><%= rfq_information.pickup_date %></td> </tr>
            </table>

            <table width="80%">
                <tr><th>Dropoff Information</th><th></th></tr>
